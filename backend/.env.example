DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asset_management
CORS_ORIGINS=["http://localhost:5173"]
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Пароль демо-пользователей для `python -m app.seed`; пусто — сгенерируется и будет выведен
SEED_PASSWORD=
# Карта территорий: в закрытой сети — свой сервер тайлов и свой Nominatim (пусто — без поиска адреса)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GEOCODER_URL=https://nominatim.openstreetmap.org
